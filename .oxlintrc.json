{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css"]
      }
    ],
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__queryClient"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["scripts/**/*.mjs", "vite.config.ts", "playwright.config.ts", "tests/**/*.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/**", "node_modules/**", "tests/api/generated/**", "playwright-report/**", "test-results/**"]
}
